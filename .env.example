# Server-only configuration. Set in the API and worker environment; never in Vite.
DATABASE_URL=
SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=production
# Optional market-data provider credential; never expose it to the browser.
BRAPI_API_KEY=
# Persistent writable storage shared with the backup worker; not an ephemeral container path.
BACKUP_DIR=
# Playwright only: a separate, migrated database whose name contains test or e2e.
# Never set this to DATABASE_URL for production or a shared development database.
E2E_DATABASE_URL=
