{
  "name": "investy",
  "version": "0.1.0",
  "private": true,
  "description": "Investy — multi-user investment portfolio dashboard for the Brazilian retail market",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "prettier": "^3.3.0",
    "typescript-eslint": "^8.15.0"
  }
}