{
  "name": "@investy/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Investy shared domain: portfolio math, money (integer cents), FX, rateio — pure TypeScript, zero external dependencies (ADR-002)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "typescript": "~5.8.3",
    "vitest": "^3.1.0"
  }
}